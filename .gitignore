# Large data files (download separately)
data/benchmark/indra_benchmark_corpus.json.gz
data/_cold/
data/benchmark/indra_assembly_curations.json
data/benchmark/indra_db_20250916/

# Benchmark scratch / generated artifacts (reproducible; not checked in).
# Tracked benchmark fixtures (eval_curation_v1*, rasmachine_*, holdout*,
# fewshot_pool*, eval_set_v4, belief_benchmark, probe_*, example_pairs) stay
# tracked — these patterns are scoped to the specific scratch filenames only.
data/benchmark/ALL_curations_global.json
data/benchmark/direction_reversals.json
data/benchmark/rasmachine_full_curations.json
data/benchmark/eval_curation_v1_clean.jsonl

# IDE / tool state
.idea/
.vscode/
.claude/
*.swp

# Generated analysis artifacts (reproducible from the scripts; not checked in):
# run outputs, result json/md, profiles, exports. A few legacy records
# under data/results/ remain tracked from earlier commits; NEW artifacts are
# ignored. Force-add (git add -f) if you ever truly need to track one.
# Tracked for audit (all present in `git ls-files data/results/`): the local
# calibration ship-gate, the calibration confirm + stage0 decision records, and
# the eval-curation head-to-head compare. The two *_external ship-gate decision
# records are NOT tracked — they are whitelisted here and force-added at ship
# time. Raw *.jsonl run outputs stay ignored; their exact SHA-256s are embedded
# in the decision records.
data/results/*
!data/results/calibration_ship_gate.md
!data/results/calibration_ship_gate.json
!data/results/calibration_confirm.md
!data/results/calibration_confirm.json
!data/results/calibration_stage0.md
!data/results/calibration_stage0.json
!data/results/eval_curation_v1_compare.md
!data/results/calibration_ship_gate_external.md
!data/results/calibration_ship_gate_external.json
!data/results/calibration_ship_gate_local.md
!data/results/calibration_ship_gate_local.json
# The validation gold two enabled profiles pin by sha (HOLDOUT_GOLD_SHA256);
# a clean checkout must hold every gold its profiles cite.
!data/results/cc_holdout_cc/
data/results/cc_holdout_cc/*
!data/results/cc_holdout_cc/holdout_cc.jsonl

# The /paper comparison artifacts. Tracked because the viewer READS them: without
# them every figure on /paper gates to "unavailable" on a fresh clone, and nobody
# outside this machine can check a number the page prints. They are small, derived
# and deterministic (each generator re-emits identical bytes), and each carries its
# own sha256 in a sibling manifest.
#
# Whitelisted per FILE, not per directory. `per_evidence_pairs.jsonl` is 3.9 MB of
# raw per-evidence rows that nothing loads, and it stays ignored — the rule that
# raw run outputs are untracked still holds.
!data/results/indra_paper_literal_models_20260724/
!data/results/indra_paper_literal_models_20260724/*.json
!data/results/indra_paper_literal_models_20260724/*.md
!data/results/deployed_baseline_replication_20260727/
!data/results/deployed_baseline_replication_20260727/*.json
!data/results/per_evidence_comparison_20260727/
!data/results/per_evidence_comparison_20260727/per_evidence_comparison.json
!data/results/per_evidence_comparison_20260727/per_evidence_comparison.md
!data/results/reasoning_ablation_20260805/
!data/results/reasoning_ablation_20260805/*.json
# Un-ignoring a directory un-ignores everything in it, and a later `!` rule only
# ADDS — so the raw rows need an explicit re-exclude or they ride along.
data/results/per_evidence_comparison_20260727/per_evidence_pairs.jsonl
# Generated corpus inputs (statement JSONs reproduced via eval_to_statements_json
# from the benchmark corpus). Three fixtures are tracked — synthetic_demo.json,
# sampled_statements_rasmachine_v1.pkl and external_curator_gold_v2_statements
# .json, the last named by research/corpus_belief_runbook.md as a runbook input.
# `/*` rather than `/` because git cannot re-include a file whose parent
# DIRECTORY is excluded; force-add a new one if needed.
data/corpora/*
!data/corpora/synthetic_demo.json
!data/corpora/sampled_statements_rasmachine_v1.pkl
!data/corpora/external_curator_gold_v2_statements.json
scripts/realistic_gate_results.json
scripts/composition_benchmark.json

# Corpus interface artifacts (reproducible from ingest + score_corpus)
data/corpus.duckdb
data/exports/

# Brutalist / playwright pass artifacts
*.png
.playwright-mcp/
snapshot.md
*-snapshot.md

# OS
.DS_Store
Thumbs.db

# Environment
.env
# Model run outputs: 19 GB of per-evidence attempts, predictions and manifests
# across every scored model. The derived artifacts the viewer reads are tracked
# under data/results/ and each embeds the sha256 of the run it came from, so the
# provenance chain survives without the raw rows.
data/comparison/

data/comparison/error_review.key
data/comparison/error_reviews/
data/comparison/error_review_admin/

# Reasoning-off twin of the run above, same scale and the same reason to ignore.
# The three small config files ARE tracked: they are the experiment's definition,
# they are kilobytes, and the run above taught us the cost of a run_plan that
# exists only on one Mac. `/*` rather than `/` because git cannot re-include a
# file whose parent DIRECTORY is excluded.
data/comparison_noreason/*
!data/comparison_noreason/run_plan.json
!data/comparison_noreason/inputs.json
!data/comparison_noreason/pricing.json

# Verdict-only run: same scale again, plus a 57 MB derived replay substrate.
# Its four config files are tracked; the substrate is not, because
# scripts/build_verdict_only_replay.py regenerates it deterministically from the
# thinking run's substrate — the generator is the durable artifact, not its output.
data/comparison_verdict_only/*
!data/comparison_verdict_only/run_plan.json
!data/comparison_verdict_only/inputs.json
!data/comparison_verdict_only/aggregation.json
!data/comparison_verdict_only/pricing.json

# Slidev authoring source + its local theme are tracked. Generated builds, PDFs,
# dependency trees, and the superseded second-reader working directory are local.
# Slide decks: 1.7 GB, and node_modules/dist alone did not cover it — the built
# assets and media sit outside both.
presentations/
presentations/**/node_modules/
presentations/**/dist/
presentations/**/*.pdf
presentations/second-reader/

# Probe-battery raw sweeps: 5.4MB of per-probe MLX reads, regenerable in ~2h via
# scripts/run_probe_battery.py from a seeded sample. The DECISION artifacts
# (decision*.json, killgate.json) and the smoke fixture are small and ARE tracked,
# because they are what a reader needs to audit the verdict without a GPU.
data/probe_battery/probes_fit.jsonl
data/probe_battery/probes_test.jsonl
data/probe_battery/holdout_scores*.jsonl
