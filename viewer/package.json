{
	"name": "viewer",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:cost": "node --experimental-strip-types scripts/test-cost-format.mjs",
		"test:calibration": "node --experimental-strip-types scripts/test-calibration-contract.mjs",
		"test:belief": "node --experimental-strip-types scripts/test-belief-comparison-contract.mjs",
		"test:paper-literal": "node --experimental-strip-types scripts/test-paper-literal-contract.mjs",
		"test:paper-verdict": "node --experimental-strip-types scripts/test-paper-verdict-contract.mjs",
		"test:paper-prose": "node --experimental-strip-types scripts/test-paper-prose-coverage.mjs",
		"test:paper-audit": "node --experimental-strip-types scripts/test-paper-audit-trail-contract.mjs",
		"test:paper-ladder": "node --experimental-strip-types scripts/test-belief-ladder-contract.mjs",
		"test:per-evidence": "node --experimental-strip-types scripts/test-per-evidence-contract.mjs",
		"test:reasoning-ablation": "node --experimental-strip-types scripts/test-reasoning-ablation-contract.mjs",
		"test:deployed-baseline": "node --experimental-strip-types scripts/test-deployed-baseline-contract.mjs",
		"validate:belief:publication": "node --experimental-strip-types scripts/validate-belief-comparison-publication.mjs",
		"test:belief-vs-indra": "node --experimental-strip-types scripts/test-belief-vs-indra-contract.mjs",
		"test:curation": "node --experimental-strip-types scripts/test-curation-sampling.mjs"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/node": "^25.6.2",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"typescript": "^6.0.2",
		"vite": "^8.0.7"
	}
}
